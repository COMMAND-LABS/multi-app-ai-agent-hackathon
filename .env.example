# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values. .env is git-ignored.
# ---------------------------------------------------------------------------

# ---- YouTube ---------------------------------------------------------------
# Data API v3 key (public data: channels, videos, playlists, search, comments).
# Google Cloud Console -> APIs & Services -> Credentials -> Create API key.
# Enable "YouTube Data API v3" on the project.
YOUTUBE_API_KEY=

# ---- Airtable (integration coming next) ------------------------------------
# Personal access token: https://airtable.com/create/tokens
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ---- Metricool (integration coming next) -----------------------------------
# Settings -> API in Metricool
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=

# ---- General ---------------------------------------------------------------
# Where pulled data is written. Relative to the project root.
DATA_DIR=data

# ---- Google Cloud Storage --------------------------------------------------
# Uses Application Default Credentials (gcloud auth application-default login) unless a
# service-account key path is set here. Bucket name lives in pipeline.toml [gcs].
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
