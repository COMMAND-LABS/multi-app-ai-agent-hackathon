# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values. .env is git-ignored.
# ---------------------------------------------------------------------------

# ---- YouTube ---------------------------------------------------------------
# Data API v3 key (public data: channels, videos, playlists, search, comments).
# Google Cloud Console -> APIs & Services -> Credentials -> Create API key.
# Enable "YouTube Data API v3" on the project.
YOUTUBE_API_KEY=

# Default channel to pull from when a command doesn't specify one.
# Either an ID (starts with "UC...") or a handle (starts with "@").
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_HANDLE=

# Optional: OAuth client for private data (your own channel via --mine,
# YouTube Analytics reports). Create an OAuth 2.0 Client ID of type
# "Desktop app" and enable "YouTube Analytics API" as well.
# Run `uv run python -m integrations.youtube auth` once to get a token.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Where the OAuth token is cached after `auth` (git-ignored).
YOUTUBE_TOKEN_FILE=.secrets/youtube_token.json

# ---- Airtable ------------------------------------------------------------
# Personal access token: https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write, schema.bases:read, schema.bases:write
# and add the base below under "Access".
AIRTABLE_API_KEY=
# Base ID starts with "app" — from the base URL: https://airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=

# ---- Metricool (integration coming next) -----------------------------------
# Settings -> API in Metricool
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=

# ---- General ---------------------------------------------------------------
# Where pulled data is written. Relative to the project root.
DATA_DIR=data
